function card(p, featured=false){return `<article class="story-card ${featured?'story-featured':''}" data-category="${esc(p.category)}"><a class="story-image" href="/articles/${esc(p.slug)}/" ${p.image ? `style="background-image:url('${esc(p.image)}')"` : ''}><span class="image-tag">${esc(p.category)}</span></a><div class="story-copy"><p class="eyebrow">${esc(p.kicker || p.category)} <span>·</span> ${esc(p.readingTime || '4 min read')}</p><h${featured?'1':'2'}><a href="/articles/${esc(p.slug)}/">${esc(p.title)}</a></h${featured?'1':'2'}><p class="story-summary">${esc(p.excerpt)}</p><p class="story-meta">${esc(p.author || '919Racing Staff')} <span>·</span> ${esc(p.date)}</p></div></article>`}
